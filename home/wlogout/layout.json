[
  {
    "label": "lock",
    "action": "swaylock",
    "text": "锁屏",
    "keybind": "l"
  },
  {
    "label": "logout",
    "action": "niri msg action quit",
    "text": "注销",
    "keybind": "e"
  },
  {
    "label": "reboot",
    "action": "systemctl reboot",
    "text": "重启",
    "keybind": "r"
  },
  {
    "label": "shutdown",
    "action": "systemctl poweroff",
    "text": "关机",
    "keybind": "s"
  }
]
